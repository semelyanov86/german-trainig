# ── Speech-to-text ──────────────────────────────────────────────
# STT engine: "groq" (default), "polza", "openrouter" or "custom"
STT_ENGINE=polza
GROQ_API_KEY=gsk_your_groq_api_key_here
# Polza STT model (default: openai/gpt-4o-transcribe)
POLZA_STT_MODEL=openai/gpt-4o-transcribe
# OpenRouter STT model (used when STT_ENGINE=openrouter; default: openai/gpt-4o-transcribe)
OPENROUTER_STT_MODEL=openai/gpt-4o-transcribe

# Custom STT: any OpenAI-compatible audio/transcriptions endpoint (used when
# STT_ENGINE=custom). Everything about it lives here, so moving to another
# server or model is one line and no rebuild. In production this is a
# self-hosted whisper.cpp + ggml-large-v3 server with silero VAD, which returns
# an empty transcript on silence instead of inventing phrases out of line noise.
CUSTOM_STT_URL=https://dialog.praxisconcierge.de/api/v1/transcribe
CUSTOM_STT_API_KEY=your_whisper_token_here
# Empty: the "model" field is not sent (the endpoint picks its own). Set it for
# services that require the field.
CUSTOM_STT_MODEL=
# Default: de. Use "auto" to omit the field and let the endpoint decide —
# language=auto is rejected with 400 by the production endpoint.
CUSTOM_STT_LANGUAGE=de
# Seconds. Deliberately longer than the server's own 25s cut-off, so its error
# message reaches the log instead of our own anonymous timeout.
CUSTOM_STT_TIMEOUT=30

# STT fallback: a self-hosted endpoint is one host with one GPU and no
# provider-side model chain, so a failed transcription (network error, timeout,
# 5xx, 503 "at capacity", 401) is retried on a hosted engine. Empty disables it.
# An EMPTY transcript is not a failure and never reaches the fallback: that is
# how the server reports "no speech". A reply with no "text" field at all IS a
# failure and does reach the fallback.
# Unlike STT_ENGINE, an unrecognised value here is refused (logged as ERROR) and
# disables the fallback, so a typo cannot send the audio to another provider.
STT_FALLBACK_ENGINE=openrouter
# Seconds; caps whichever engine serves as the fallback, independent of the 60s
# it would use as a primary. Worst case then is 30s + 20s of hold music, not 90s.
STT_FALLBACK_TIMEOUT=20

# ── Text-to-speech ──────────────────────────────────────────────
# TTS engine: "piper", "openai", "elevenlabs", "polza", or "openrouter"
TTS_ENGINE=polza
# Polza TTS (used when TTS_ENGINE=polza)
POLZA_TTS_MODEL=openai/tts-1
POLZA_TTS_VOICE=nova
# OpenRouter TTS (used when TTS_ENGINE=openrouter)
# NOTE: OpenRouter does not host OpenAI tts-1. Use a TTS model it actually
# serves, e.g. google/gemini-3.1-flash-tts-preview (voices: Kore, Aoede,
# Zephyr, Puck, …). Gemini TTS only accepts response_format=pcm.
OPENROUTER_TTS_MODEL=google/gemini-3.1-flash-tts-preview
OPENROUTER_TTS_VOICE=Kore
# Response format: "mp3" for OpenAI-style models, "pcm" for Gemini TTS
# (raw 16-bit mono PCM; the backend reads the sample rate from the response).
OPENROUTER_TTS_FORMAT=pcm
# OpenAI TTS (used when TTS_ENGINE=openai)
OPENAI_TTS_API_KEY=sk-your_openai_api_key_here
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova
# ElevenLabs (used when TTS_ENGINE=elevenlabs)
ELEVENLABS_API_KEY=sk_your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_flash_v2_5
# Piper (local, used when TTS_ENGINE=piper)
PIPER_MODEL=/root/piper-voices/de_DE-kerstin-low.onnx

# ── Polza API key (shared by STT, TTS and LLM when selected) ─────
POLZA_API_KEY=your_polza_api_key_here

# ── OpenRouter API key (shared by STT and TTS when selected) ─────
OPENROUTER_API_KEY=sk-or-your_openrouter_api_key_here

# ── LLM (dialogue + post-call summary) ──────────────────────────
# Provider: "polza" (default), "openrouter" or "claude" (CLI fallback).
LLM_ENGINE=polza
# Per-task overrides. Unset means "inherit LLM_ENGINE", so the dialogue and
# the report can run on different providers — e.g. a fast HTTP model for the
# call and the Claude CLI for the report.
LLM_DIALOG_ENGINE=
LLM_SUMMARY_ENGINE=

# Dialogue model (real-time conversation). Switch with one line. The id must
# match the engine above: polza and openrouter have separate catalogues.
# Defaults when left empty: openai/gpt-5.4-mini on polza,
# mistralai/mistral-medium-3-5 on openrouter.
LLM_MODEL=openai/gpt-5.4-mini
# Reasoning effort: minimal|low|medium|high. Set ONLY for reasoning
# models (gpt-5.x, gemini-3.x …). Leave empty for plain models such
# as openai/gpt-4o-mini.
# Careful on openrouter: some non-reasoning models accept this field and
# switch thinking ON, which costs seconds per turn. Measured on
# mistralai/mistral-medium-3-5: 0.7s without it, 6.2s with effort=minimal.
LLM_DIALOG_REASONING=minimal
# Temperature. Leave empty for reasoning models that reject it
# (e.g. gpt-5.x); set e.g. 0.8 for plain models.
LLM_DIALOG_TEMPERATURE=
LLM_DIALOG_MAX_TOKENS=1000
# Fallback models for the dialogue, tried in order when LLM_MODEL errors out.
# openrouter only — it is sent as that API's "models" array, so the router picks
# the next entry inside the same request and an upstream rate limit costs no
# extra round trip. Prefer ids served by *different* upstream vendors than
# LLM_MODEL: a shared-pool 429 hits one vendor at a time (on 2026-08-19 Mistral
# was rate-limited and the whole dialogue died in silence).
# NOTE: OpenRouter validates every id up front, so one typo here returns HTTP
# 400 for the whole request. The app reads the rejected id out of that error and
# drops just that entry, keeping the rest of the chain — check the log for
# "rejected fallback model". A typo in LLM_MODEL itself cannot be recovered and
# fails the turn immediately.
# Leave the key present but empty to disable the fallback entirely.
# Default when the key is absent: google/gemini-3.5-flash-lite (0.6-1.1s on a
# tutor-sized turn, ~half the primary's cost, no hidden thinking). Add more ids
# comma-separated to get a deeper chain, e.g. openai/gpt-5.4-mini after it.
LLM_DIALOG_FALLBACK_MODELS=google/gemini-3.5-flash-lite
# Attempts per dialogue turn on a temporary failure (429/5xx/connection reset).
# Kept low on purpose: the caller waits on hold music, and after
# maxConsecutiveErrors failed turns the app apologises in German and hangs up.
LLM_DIALOG_RETRIES=2

# Post-call summary model (Russian report; not latency-sensitive).
# Default when empty: google/gemini-3.5-flash on polza,
# mistralai/mistral-medium-3-5 on openrouter.
LLM_SUMMARY_MODEL=google/gemini-3.5-flash
LLM_SUMMARY_TEMPERATURE=0.4
LLM_SUMMARY_REASONING=
LLM_SUMMARY_MAX_TOKENS=8000
# Same as the dialogue knobs, for the report. Nobody is waiting on the line
# here, so it retries more patiently.
LLM_SUMMARY_FALLBACK_MODELS=
LLM_SUMMARY_RETRIES=3

# Claude CLI fallback (used whenever a task's engine resolves to "claude").
# NOTE: this backend ignores LLM_MODEL / LLM_SUMMARY_MODEL and runs CLAUDE_MODEL.
CLAUDE_MODEL=sonnet
CLAUDE_BIN=/root/.local/bin/claude

# ── Prompts (system prompts shipped with the app) ───────────────
# Deployed by `task install` from the repo's SKILL.md / summary_skill.md
SKILL_FILE=/etc/german-trainer/SKILL.md
SUMMARY_SKILL_FILE=/etc/german-trainer/summary_skill.md

# ── Misc ────────────────────────────────────────────────────────
HISTORY_DIR=/root/ai
THEMES_FILE=/root/german-trainer/themes.txt
NOTIFY_WEBHOOK_URL=https://bot.sergeyem.ru/webhooks/notify
NOTIFY_WEBHOOK_TOKEN=your_webhook_token_here
WEBHOOK_URL=https://bot.sergeyem.ru
