# Independent psychologist settings; credentials and shared endpoints come
# from the base .env. Production renders these from its own Ansible vault dict.
LANGUAGE=ru
STT_LANGUAGE=ru
CUSTOM_STT_LANGUAGE=ru
SKILL_FILE=/etc/german-trainer/psychologist_skill.md
SUMMARY_SKILL_FILE=/etc/german-trainer/psychologist_summary_skill.md
GREETING_NOTICE=Привет! Как хорошо, что ты позвонил! Я ИИ-собеседник.
GREETING_PROMPT=После тёплого приветствия приложения скажи: «Расскажи, как ты? Что тебя беспокоит? Можешь говорить честно и открыто, в своём темпе». Обращайся на «ты», добавь уместную эмоцию по инструкции текущего голоса. Не повторяй приветствие и информацию об ИИ: приложение произнесёт их отдельно. Не упоминай запись разговора и письменный отчёт.
SILENCE_PROMPT=Сейчас речь не слышна. Мягко сообщи об этом, не торопи собеседника и не меняй тему.
SILENCE_LINE=Я сейчас тебя не слышу. Когда будешь готов, продолжай.
FAREWELL_LINE=Пока. Спасибо, что поделился.
GLITCH_LINE=Извини, возникла техническая ошибка. Я не смогла разобрать ответ. Повтори, пожалуйста.
OUTAGE_LINE=Извини, из-за технической ошибки сейчас не получается продолжить разговор. Пожалуйста, попробуй позвонить позже.
FAREWELL_PHRASES=до свидания,спасибо до свидания,на сегодня всё до свидания,на сегодня все до свидания,давайте закончим разговор,хочу закончить разговор
FAREWELL_MODE=utterance
HISTORY_ROLE=Психолог
MAX_RECORD_SECONDS=420
SUMMARY_ENABLED=true
SUMMARY_MODE=transcript_advice
SUMMARY_PREFIX=На основе транскрипта подготовь только короткие письменные рекомендации. Транскрипт:
LOG_UTTERANCES=false
TTS_STYLE_TAGS=auto
# Dialog/report models are independent of the voice used by this profile.
LLM_ENGINE=codex
LLM_DIALOG_ENGINE=codex
LLM_SUMMARY_ENGINE=codex
LLM_MODEL=gpt-6-luna
LLM_SUMMARY_MODEL=gpt-6-luna
LLM_DIALOG_REASONING=low
LLM_SUMMARY_REASONING=medium
LLM_DIALOG_MAX_TOKENS=0
LLM_SUMMARY_MAX_TOKENS=3000
STT_ENGINE=custom
CUSTOM_STT_TIMEOUT=60
STT_FALLBACK_ENGINE=openrouter
STT_FALLBACK_TIMEOUT=60
OPENROUTER_STT_MODEL=openai/gpt-4o-transcribe
TTS_ENGINE=elevenlabs
# The existing ELEVENLABS_API_KEY is inherited from the base .env.
ELEVENLABS_MODEL=eleven_v3_conversational
# Sarah: female, soft. Choose another voice by changing only this profile.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# Named profiles require an explicit report recipient; never inherit implicitly.
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_TOKEN=
